{
  "permissions": {
    "allow": [
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo run *)",
      "Bash(cargo tree *)",
      "Bash(cargo metadata *)",
      "Bash(cargo deny check *)",
      "Bash(cargo zigbuild *)",
      "Bash(scripts/*)",
      "Bash(bash scripts/*)",
      "Bash(python tools/*)",
      "Bash(python3 tools/*)",
      "Bash(shellcheck *)",
      "PowerShell(cargo build *)",
